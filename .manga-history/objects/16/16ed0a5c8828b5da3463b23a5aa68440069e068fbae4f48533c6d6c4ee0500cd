{
  "cast": {
    "ananya": {
      "name": "Dr. Ananya",
      "description": "Indian woman in her late 30s, clinic owner and doctor. Calm, confident and caring. Teal kurta beneath an open white coat (source). Shoulder-length black hair tied in a low bun with a few loose strands, slim build, small gold stud earrings, a stethoscope worn around her neck (never in use) in every scene where she wears the white coat (manga supplement, from the accepted reference sheet).",
      "faceDesign": {
        "traits": [
          "Calm almond-shaped eyes with slightly heavy upper lids and a gentle downward outer corner",
          "Soft, straight medium-thick eyebrows set fairly level",
          "Oval face with a defined, slightly pointed chin and a small bindi-free forehead; small nose with a rounded tip"
        ],
        "reference": "works/welbuk-24/assets/characters/main-cast.png",
        "settingBasis": "Source: Indian female clinic owner, late 30s, calm, confident, caring; teal kurta beneath white coat. Manga supplement: the three face traits, low bun hairstyle and gold studs, chosen to separate her from Meera."
      }
    },
    "meera": {
      "name": "Meera",
      "description": "Indian woman in her late 20s, clinic receptionist. Friendly and capable. Blue kurta (source). Long black hair in a single side braid over her left shoulder, round face, slim build, a thin silver bangle on the right wrist (manga supplement).",
      "faceDesign": {
        "traits": [
          "Large, round bright eyes with clearly visible lower lash line",
          "Thin, gently arched eyebrows set high above the eyes",
          "Round face with full cheeks and a short soft chin; small dimple on the left cheek when smiling"
        ],
        "reference": "works/welbuk-24/assets/characters/main-cast.png",
        "settingBasis": "Source: Indian female receptionist, late 20s, friendly and capable, blue kurta. Manga supplement: the three face traits, side braid and silver bangle."
      }
    },
    "ravi": {
      "name": "Ravi",
      "description": "Indian man in his mid-30s, patient. Warm and approachable. Light green shirt (source). Short neat black hair with a side part, trimmed short beard, medium build, dark trousers, a simple wristwatch on the left wrist, small dark-brown shoulder bag (manga supplement).",
      "faceDesign": {
        "traits": [
          "Warm, slightly narrow eyes that crease at the outer corners when he smiles",
          "Thick, straight dark eyebrows close to the eyes",
          "Square jaw framed by a short trimmed beard and a broad nose"
        ],
        "reference": "works/welbuk-24/assets/characters/main-cast.png",
        "settingBasis": "Source: Indian male patient, mid-30s, warm, approachable, light green shirt. Manga supplement: the three face traits, beard, side part and wristwatch."
      }
    },
