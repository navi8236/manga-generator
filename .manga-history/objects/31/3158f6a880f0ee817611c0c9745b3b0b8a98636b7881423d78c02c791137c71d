  const dil = raw.map((r, y) => r.map((_, x) => {
    for (let dy = -1; dy <= 1; dy++) for (let dx = -1; dx <= 1; dx++) if (raw[y + dy]?.[x + dx]) return 1;
    return 0;
  }));
  const S = Array.from({ length: m.h + 1 }, () => new Int32Array(m.w + 1));
  for (let y = 0; y < m.h; y++) for (let x = 0; x < m.w; x++) S[y + 1][x + 1] = dil[y][x] + S[y][x + 1] + S[y + 1][x] - S[y][x];
  return ([bx, by, bw, bh]) => {
    const c = m.cell, x0 = Math.max(0, Math.floor(bx / c)), y0 = Math.max(0, Math.floor(by / c));
    const x1 = Math.min(m.w, Math.ceil((bx + bw) / c)), y1 = Math.min(m.h, Math.ceil((by + bh) / c));
    const n = (x1 - x0) * (y1 - y0);
    return n ? (S[y1][x1] - S[y0][x1] - S[y1][x0] + S[y0][x0]) / n : 1;
