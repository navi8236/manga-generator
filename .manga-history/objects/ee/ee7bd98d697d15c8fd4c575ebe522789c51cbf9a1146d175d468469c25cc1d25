// Helpers -------------------------------------------------------------------
const panelRect = (x, y, w, h) => [x, y, w, h];
function face(rect, local) {
  return [rect[0] + local[0], rect[1] + local[1], local[2], local[3]];
}
function speaker(rect, local) {
  const f = face(rect, local);
  return {
    anchor: [Math.round(f[0] + f[2] / 2), Math.round(f[1] + f[3] * 0.8)],
    face: f,
  };
}
function line(speakerId, lines, x, dy, extra = {}) {
  const textColumns = lines.map((s, i) => (i < lines.length - 1 ? s + ' ' : s));
  return {
    speaker: speakerId,
    text: textColumns.join(''),
    textColumns,
    textDirection: 'horizontal',
    side: 'left',
    x,
    dy,
    ...extra,
  };
}
const hands = (left, right) => ({ left, right });
const prop = (id, before, during, after, heldBy) => ({ id, before, during, after, heldBy });

